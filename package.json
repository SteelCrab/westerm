{
  "name": "westerm",
  "version": "0.4.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare:cargo": "vite build && node scripts/prepare-cargo.mjs",
    "pack:cargo": "npm run prepare:cargo && cargo package --allow-dirty --locked --manifest-path native/Cargo.toml",
    "test:cargo": "node --test tests/cargo-package.test.mjs",
    "test:cargo-install": "node scripts/test-cargo-install.mjs",
    "pack:npm": "node scripts/prepare-npm.mjs && npm pack ./dist-npm",
    "test:npm": "node --test tests/npm-package.test.mjs",
    "test:npm-install": "node scripts/test-npm-install.mjs",
    "build": "vite build && cargo build --release --manifest-path native/Cargo.toml",
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "dev:server": "cargo run --manifest-path native/Cargo.toml -- serve --allow-origin http://localhost:5173 --allow-origin http://127.0.0.1:5173",
    "build:app": "node scripts/desktop.mjs build",
    "app:dev": "node scripts/desktop.mjs dev",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts && cargo test --manifest-path native/Cargo.toml"
  },
  "dependencies": {
    "@wterm/core": "^0.5.9",
    "@wterm/dom": "^0.5.9",
    "@wterm/ghostty": "^0.5.9",
    "@wterm/react": "^0.5.9",
    "lucide-react": "^1.70.0",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "description": "Web Session Terminal: a web terminal whose sessions survive closed tabs, restarts, and reboots. Built on wterm."
}
